# basic_rules 模块注册的规则类型
# conf 格式（推荐）：[类型名] 段 + key=value 属性行
#   format       — 值格式：path（单值路径）/ pair（src|dst 双值）/ switch（ON/OFF 开关）/ tokens（多 token）
#   argc=N       — 恰好 N 个参数；argc=N:M — N~M 个参数（M 用 * 或不写表示不限上界）
#   global-only  — true/false：仅全局作用域可用
#   desc         — 中文描述（默认语言）；desc.en / desc.ja 等为指定语言描述
# rule_server 启动及每次命令前扫描本文件，动态合并进支持的规则类型表

[HIDE]
format = path
argc = 1
desc = 隐藏路径
desc.en = Hide path

[RO]
format = path
argc = 1
desc = 只读路径
desc.en = Read-only path

[REDIRECT]
format = pair
argc = 2
desc = 路径重定向：<虚拟路径>|<真实路径>
desc.en = Path redirect: <virtual path>|<real path>

[ALLOW]
format = path
argc = 1
desc = 放行路径
desc.en = Allow path

[MONITOR]
format = switch
desc = 监控开关
desc.en = Monitor switch

[SANDBOX]
format = switch
desc = 沙盒开关
desc.en = Sandbox switch

[GLOBAL_INJECT]
format = switch
global-only = true
desc = 全局注入开关
desc.en = Global injection switch

[SKIP_SYSTEM_APPS]
format = switch
global-only = true
desc = 跳过系统应用开关
desc.en = Skip system apps switch

[FUSE_DIRECT]
format = switch
global-only = true
desc = FUSE 直通开关
desc.en = FUSE direct pass-through switch
