From: Fuse-Proxy
Date: 2026-06-14
Subject: [PATCH 3/5] fuse_lowlevel.c: Implement passthrough API functions

Add from Google/libfuse:
- fuse_reply_canonical_path() implementation
- FUSE_PASSTHROUGH_API_UNAVAILABLE/V0/V1/V2/STABLE enum
- fuse_passthrough_enable() with API version negotiation
- _do_canonical_path() for cached-read dispatch table (4 params)
- do_canonical_path() for standard dispatch table (3 params)
- Both dispatch table entries for FUSE_CANONICAL_PATH opcode
- _do_init() passthrough capability override for custom Android kernels

diff --git a/lib/fuse_lowlevel.c b/lib/fuse_lowlevel.c
--- a/lib/fuse_lowlevel.c
+++ b/lib/fuse_lowlevel.c
@@ -557,6 +557,97 @@ int fuse_reply_readlink(fuse_req_t req, const char *linkname)
 	return send_reply_ok(req, linkname, strlen(linkname));
 }

+int fuse_reply_canonical_path(fuse_req_t req, const char *path)
+{
+	/* Kernel expects null-terminated buffer */
+	return send_reply_ok(req, path, strlen(path) + 1);
+}
+
+/* Passthrough API version detection enum */
+enum {
+	FUSE_PASSTHROUGH_API_UNAVAILABLE,
+	FUSE_PASSTHROUGH_API_V0,
+	FUSE_PASSTHROUGH_API_V1,
+	FUSE_PASSTHROUGH_API_V2,
+	FUSE_PASSTHROUGH_API_STABLE,
+};
+
+/**
+ * Enable passthrough for a file descriptor.
+ * Tries upstream BACKING_OPEN first, then falls back
+ * to Android V2/V1/V0 passthrough ioctls.
+ *
+ * @return positive backing_id on success, <=0 on error
+ */
+int fuse_passthrough_enable(fuse_req_t req, unsigned int fd)
+{
+	static int passthrough_version = FUSE_PASSTHROUGH_API_STABLE;
+	int ret = 0;
+
+	/* Try upstream FUSE passthrough first */
+	{
+		struct fuse_backing_map map = { .fd = (int)fd };
+		ret = ioctl(req->se->fd, FUSE_DEV_IOC_BACKING_OPEN, &map);
+		if (ret > 0)
+			return ret;
+	}
+
+	/* Fall back to Android-specific passthrough ioctls */
+	switch (passthrough_version) {
+	case FUSE_PASSTHROUGH_API_STABLE:
+		passthrough_version = FUSE_PASSTHROUGH_API_V2;
+		/* fall through */
+	case FUSE_PASSTHROUGH_API_V2:
+		ret = ioctl(req->se->fd, FUSE_DEV_IOC_PASSTHROUGH_OPEN_V2, &fd);
+		if (ret == -1 && errno == ENOTTY)
+			passthrough_version = FUSE_PASSTHROUGH_API_V1;
+		else break;
+		/* fall through */
+	case FUSE_PASSTHROUGH_API_V1: {
+		struct fuse_passthrough_out_v0 out = {};
+		out.fd = fd;
+		ret = ioctl(req->se->fd, FUSE_DEV_IOC_PASSTHROUGH_OPEN_V1, &out);
+		if (ret == -1 && errno == ENOTTY)
+			passthrough_version = FUSE_PASSTHROUGH_API_V0;
+		else break;
+		/* fall through */
+	}
+	case FUSE_PASSTHROUGH_API_V0: {
+		struct fuse_passthrough_out_v0 out = {};
+		out.fd = fd;
+		ret = ioctl(req->se->fd, FUSE_DEV_IOC_PASSTHROUGH_OPEN_V0, &out);
+		if (ret == -1 && errno == ENOTTY)
+			passthrough_version = FUSE_PASSTHROUGH_API_UNAVAILABLE;
+		else break;
+		/* fall through */
+	}
+	default:
+		fuse_log(FUSE_LOG_ERR, "fuse: passthrough_enable: no valid API\n");
+		return -ENOTTY;
+	}
+
+	if (ret <= 0)
+		fuse_log(FUSE_LOG_ERR, "fuse: passthrough_enable: %s\n",
+			 strerror(errno));
+	return ret;
+}
+
+/* --- Canonical path handlers --- */
+static void _do_canonical_path(fuse_req_t req, const fuse_ino_t nodeid,
+			       const void *op_in, const void *in_payload)
+{
+	(void)op_in; (void)in_payload;
+	if (req->se->op.canonical_path)
+		req->se->op.canonical_path(req, nodeid);
+	else
+		fuse_reply_err(req, ENOSYS);
+}
+
+static void do_canonical_path(fuse_req_t req, const fuse_ino_t nodeid,
+			      const void *inarg)
+{
+	(void)inarg;
+	if (req->se->op.canonical_path)
+		req->se->op.canonical_path(req, nodeid);
+	else
+		fuse_reply_err(req, ENOSYS);
+}
+
 int fuse_passthrough_open(fuse_req_t req, int fd)

@@ -2904,7 +2996,32 @@ static void _do_init(fuse_req_t req, const fuse_ino_t nodeid, const void *op_in,
 		fuse_convert_to_conn_want_ext(&se->conn);
 	}

+	/*
+	 * FUSE passthrough capability override:
+	 *
+	 * Some custom Android kernels implement FUSE passthrough
+	 * (CONFIG_FUSE_PASSTHROUGH=y) but do not advertise the
+	 * FUSE_PASSTHROUGH capability bit (1ULL << 37) in the INIT
+	 * request flags.  Without this override, userspace cannot
+	 * enable passthrough because:
+	 *   1. capable_ext lacks FUSE_CAP_PASSTHROUGH
+	 *   2. LL_SET_DEFAULT skips setting want
+	 *   3. want_flags_valid() rejects the unknown flag
+	 *
+	 * If the init callback has set FUSE_CAP_PASSTHROUGH in want
+	 * despite the missing capability bit, we assume the kernel
+	 * actually supports it and just does not advertise it.
+	 */
+	if ((se->conn.want_ext & FUSE_CAP_PASSTHROUGH) &&
+	    !(se->conn.capable_ext & FUSE_CAP_PASSTHROUGH)) {
+		fuse_log(FUSE_LOG_DEBUG,
+			 "fuse: enabling passthrough override "
+			 "(want_ext has FUSE_CAP_PASSTHROUGH but "
+			 "capable_ext does not)\n");
+		se->conn.capable_ext |= FUSE_CAP_PASSTHROUGH;
+		se->conn.capable = fuse_lower_32_bits(se->conn.capable_ext);
+	}
+
 	if (!want_flags_valid(se->conn.capable_ext, se->conn.want_ext)) {

@@ -3494,6 +3611,7 @@ static struct {
 	...existing entries...
 	[FUSE_READLINK]	   = { do_readlink,    "READLINK"    },
+	[FUSE_CANONICAL_PATH] = { do_canonical_path, "CANONICAL_PATH" },
 	[FUSE_SYMLINK]	   = { do_symlink,     "SYMLINK"     },
 	...existing entries...

@@ -3550,6 +3668,7 @@ static struct {
 	[FUSE_READLINK]		= { _do_readlink,	"READLINK" },
+	[FUSE_CANONICAL_PATH]	= { _do_canonical_path, "CANONICAL_PATH" },
 	[FUSE_SYMLINK]		= { _do_symlink,	"SYMLINK" },
