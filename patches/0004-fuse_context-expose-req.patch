From: Fuse-Proxy
Date: 2026-06-14
Subject: [PATCH 4/5] fuse_context: expose fuse_req_t for passthrough API

Add fuse_req_t req field to struct fuse_context so high-level API
callbacks (open, create, etc.) can access the fuse request handle
via fuse_get_context()->req and call fuse_passthrough_enable().

Changes:
- include/fuse.h: add struct fuse_req forward decl + fuse_req_t typedef
- include/fuse.h: add req field to struct fuse_context
- lib/fuse.c: remove standalone req from fuse_context_i (now in ctx)
- lib/fuse.c: c->req → c->ctx.req throughout

diff --git a/include/fuse.h b/include/fuse.h
--- a/include/fuse.h
+++ b/include/fuse.h
@@ -20,4 +20,7 @@
 #include "fuse_common.h"

+/* Forward declaration for fuse_context.req */
+struct fuse_req;
+typedef struct fuse_req *fuse_req_t;
+
 #include <fcntl.h>
@@ -889,4 +892,7 @@ struct fuse_context {
 	/** Umask of the calling process */
 	mode_t umask;
+
+	/** The fuse request handle (for passthrough, etc.) */
+	fuse_req_t req;
 };

diff --git a/lib/fuse.c b/lib/fuse.c
--- a/lib/fuse.c
+++ b/lib/fuse.c
@@ -188,5 +188,4 @@ struct fuse_context_i {
 	struct fuse_context ctx;
-	fuse_req_t req;
 };
 
@@ -2577,3 +2576,3 @@ static struct fuse *req_fuse_prepare(fuse_req_t req)
 	c->req = req;							//→ c->ctx.req
-	c->req = req;
+	c->ctx.req = req;
 	c->ctx.uid = ctx->uid;
@@ -4712,3 +4711,3 @@ struct fuse_context *fuse_get_context(void)
-	return fuse_req_getgroups(c->req, size, list);
+	return fuse_req_getgroups(c->ctx.req, size, list);
@@ -4720,3 +4719,3 @@ int fuse_req_interrupted(fuse_req_t req)
-		return fuse_req_interrupted(c->req);
+		return fuse_req_interrupted(c->ctx.req);
